# Antigravity Study Platform Environment Configuration
# Copy this file to .env and provide your secrets

# -----------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Restrict sign-in to the SST Google Workspace hosted domain.
GOOGLE_ALLOWED_HD=sst.scaler.com

# SECURITY: Set to "false" (or remove) in ALL deployed/production environments.
# Mock login ("mock:...") tokens are ONLY accepted when this is "true" AND
# GOOGLE_CLIENT_ID is empty.  If GOOGLE_CLIENT_ID is set, mock tokens are
# always rejected regardless of this flag.
ALLOW_DEV_MOCK_LOGIN=true   # local dev only — override to false in Vercel env

# -----------------------------------------------------------------------
# JWT RS256 Asymmetric Keys (Base64 PEM format)
# Generate with: python tooling/generate_keys.py
# -----------------------------------------------------------------------
JWT_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0t...
JWT_PUBLIC_KEY_B64=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0...

JWT_ISSUER=antigravity-study-platform
JWT_AUDIENCE=antigravity-students
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------
# MongoDB Atlas
# Leave empty ONLY for local development (in-memory fallback).
# In production (MONGODB_URI set), a connection failure returns 503 —
# it does NOT silently fall back to in-memory storage.
# -----------------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sst_study

# -----------------------------------------------------------------------
# Upstash Redis  (rate limiter — leave empty for local in-memory limiter)
# -----------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------
# App Origin & Cookies
# -----------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false     # set to true in production (HTTPS only)

# -----------------------------------------------------------------------
# Automatic Comment Quarantine Thresholds
# -----------------------------------------------------------------------
AUTO_QUARANTINE_REPORT_THRESHOLD=5
AUTO_QUARANTINE_WINDOW_HOURS=2

# -----------------------------------------------------------------------
# Frontend Vite variables (Public — safe to expose to the browser)
# -----------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=

