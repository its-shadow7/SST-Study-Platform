{
  "name": "sst-study-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Antigravity Study Platform for Scaler School of Technology",
  "scripts": {
    "build:notes": "python tooling/build_notes.py",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:notes && npm run build:web",
    "dev": "node tooling/dev.js",
    "dev:api": "uvicorn api.index:app --reload --port 8000",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.7.3"
  }
}
